<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: drag handle + connection dot + title block + Run (non-INT) + edit/delete icons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/dragHandle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="@string/reorder_handle" />

            <View
                android:id="@+id/connDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dot_connection"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/itemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/itemSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnFavorite"
                style="@style/Widget.Remotecontrol.IconButton"
                android:src="@drawable/ic_star"
                android:contentDescription="@string/favorite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRun"
                style="@style/Widget.Remotecontrol.Button.Tonal.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/run" />

            <ImageButton
                android:id="@+id/btnPause"
                style="@style/Widget.Remotecontrol.IconButton"
                android:layout_marginStart="2dp"
                android:src="@android:drawable/ic_media_pause"
                android:contentDescription="@string/pause"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnDuplicate"
                style="@style/Widget.Remotecontrol.IconButton"
                android:layout_marginStart="2dp"
                android:src="@android:drawable/ic_menu_set_as"
                android:contentDescription="@string/copy_item" />

            <ImageButton
                android:id="@+id/btnEdit"
                style="@style/Widget.Remotecontrol.IconButton"
                android:layout_marginStart="2dp"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="@string/save" />

            <ImageButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Remotecontrol.IconButton"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="@string/delete" />
        </LinearLayout>

        <!-- INT-only stepper row. Sits below the edit/delete icons. -->
        <LinearLayout
            android:id="@+id/intActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecrement"
                style="@style/Widget.Remotecontrol.Button.Outlined.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/btn_minus" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunInt"
                style="@style/Widget.Remotecontrol.Button.Tonal.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/run" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIncrement"
                style="@style/Widget.Remotecontrol.Button.Outlined.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/btn_plus" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/presetChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="2dp"
            app:singleLine="false" />

        <TextView
            android:id="@+id/itemResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:fontFamily="monospace"
            android:maxLines="50"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
